<?xml version="1.0" encoding="utf-8"?>
<!--
  Nuclear's audio playback loads every stream through a local proxy
  (http://127.0.0.1:9100-9109/stream/..., see src-tauri/src/stream_server.rs and
  packages/player/src/services/streamResolution/audioSource.ts). Android blocks
  cleartext HTTP by default; without this config, release builds would play nothing.
  Cleartext is permitted for loopback only - all other traffic keeps the default
  (HTTPS-only, system CAs).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
